rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email.lower() == "monet0424@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Consultation Validation
    function isValidConsultation(data) {
      let requiredFields = ['name', 'phone', 'program', 'createdAt', 'status'];
      let optionalFields = ['message'];
      let allFields = requiredFields.concat(optionalFields);
      
      return data.keys().hasAll(requiredFields) &&
             data.keys().size() >= 5 && data.keys().size() <= 6 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 20 &&
             data.program is string && data.program.size() > 0 && data.program.size() <= 100 &&
             (!('message' in data) || (data.message is string && data.message.size() <= 1000)) &&
             data.status in ['pending', 'contacted', 'completed'] &&
             data.createdAt == request.time;
    }

    // 1. Consultations Collection
    match /consultations/{consultationId} {
      // Public can create, but not read/list
      allow create: if isValidConsultation(incoming());
      
      // Only admins can read, list, update, or delete
      allow read, list, delete: if isAdmin();
      
      allow update: if isAdmin() && isValidConsultation(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status'])
      );
    }

    // Admins collection - ONLY for internal use
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // Only manageable via console or service account
    }
  }
}
